# ==========================================
# Job Hunter Belgium - fichiers locaux / sensibles
# ==========================================

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Environment variables / credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.*
secrets.*
token.*
api_key.*

# Local database / caches
database/*.db
database/*.db-*
*.sqlite
*.sqlite3
.cache/
cache/
tmp/
temp/

# Generated runtime outputs
exports/logs/
exports/applications/
exports/**/*.json
exports/**/*.csv
exports/**/*.txt

# Personal application documents
*.docx
*.pdf

# Candidate personal profile
config/profile.py
config/profile_private.py

# Optional local API / AI configuration if it contains credentials
config/ai_generation.py

# Playwright / browser local artifacts
playwright-report/
test-results/

# Python packaging
build/
dist/
*.egg-info/

# ==========================================
# Ajouts du 10/09/2026
# ==========================================

# Sauvegardes SQLite locales.
# database/*.db etait deja couvert, mais pas backups/ : une sauvegarde de
# 204 Mo y attendait, au-dessus de la limite stricte de 100 Mo par fichier
# de GitHub — le push aurait ete refuse.
backups/*.db
backups/*.db-*
backups/*.sqlite
backups/*.sqlite3

# Caches HTTP des connecteurs.
# Ce sont des pages d'offres aspirees chez des tiers, regenerables a la
# demande. Les versionner alourdit chaque clone sans rien apporter, et
# publie du contenu qui ne nous appartient pas.
logs/*cache*/
# Instantanes des catalogues Actiris/Forem (absorption complete) : gros et regeneres a chaque run
logs/absorption/

# Traces de mise au point ponctuelles.
logs/*_scheduler_state.json
logs/forem_[0-9]*_*
logs/scienceatwork_listing.html
# Paquets ChatGPT (donnees de candidature) et caches HTML des employeurs directs
exports/chatgpt_handoff/
logs/batch2_direct_employers/

# Cles API privees (Jooble, Adzuna, Careerjet, VDAB) : jamais dans git
config/private/
