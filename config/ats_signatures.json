   "config": "config/ats_employers_v2.json",
   "strategy": "API_JSON",
   "endpoint": "https://api.ashbyhq.com/posting-api/job-board/{identifiant}"
  },
  "WORKABLE": {
   "url_patterns": [
    "apply\\.workable\\.com",
    "workable\\.com/j/",
    "workable\\.com/api/accounts"
   ],
   "identifier": "apply\\.workable\\.com/(?P<identifiant>[a-z0-9-]+)",
   "connector": "WORKABLE",
   "config": "config/ats_employers_v2.json",
   "strategy": "API_JSON",
   "endpoint": "https://apply.workable.com/api/v3/accounts/{identifiant}/jobs"
  },
  "PERSONIO": {
   "url_patterns": [
    "\\.jobs\\.personio\\.(?:de|com)",
