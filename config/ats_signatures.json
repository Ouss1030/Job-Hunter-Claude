   "identifier": "https?://(?P<identifiant>[a-z0-9.-]+\\.teamtailor\\.com)",
   "connector": "TEAMTAILOR",
   "config": "config/ats_employers_v2.json",
   "strategy": "RSS",
   "endpoint": "https://{identifiant}/jobs.rss"
