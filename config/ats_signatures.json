{
 "schema_version": "1.0",
 "purpose": "Registre extensible des systemes de recrutement (ATS). Utilise par sources/ats_detector_v1.py. Ajouter un ATS = ajouter une entree, sans toucher au moteur.",
 "notes": [
  "url_patterns : expressions regulieres cherchees dans l'URL finale, la chaine de redirections et le HTML.",
  "identifier : expression avec un groupe nomme (ou plusieurs) pour extraire l'identifiant exploitable par le connecteur.",
  "connector : cle du connecteur JobHunter qui sait collecter cet ATS ; null = detecte mais pas encore collecte.",
  "strategy : methode publique la plus legere connue (API_JSON, XML_FEED, SITEMAP_JSONLD, INTERNAL_JSON, HTML, NONE)."
 ],
 "ats": {
  "GREENHOUSE": {
   "url_patterns": [
    "(?:boards|job-boards)\\.greenhouse\\.io",
    "greenhouse\\.io/embed",
    "boards-api\\.greenhouse\\.io"
   ],
   "identifier": "(?:boards|job-boards)\\.greenhouse\\.io/(?:embed/job_board\\?for=)?(?P<identifiant>[a-z0-9_-]+)",
   "connector": "GREENHOUSE",
   "config": "config/greenhouse_sources.py",
   "strategy": "API_JSON",
   "endpoint": "https://boards-api.greenhouse.io/v1/boards/{identifiant}/jobs?content=true"
  },
  "LEVER": {
   "url_patterns": [
    "jobs\\.lever\\.co",
    "api\\.lever\\.co",
    "jobs\\.eu\\.lever\\.co"
   ],
   "identifier": "jobs\\.(?:eu\\.)?lever\\.co/(?P<identifiant>[a-z0-9-]+)",
   "connector": "LEVER",
   "config": "config/ats_employers_v2.json",
   "strategy": "API_JSON",
   "endpoint": "https://api.lever.co/v0/postings/{identifiant}?mode=json"
  },
  "ASHBY": {
   "url_patterns": [
    "jobs\\.ashbyhq\\.com",
