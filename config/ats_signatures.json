   ],
   "identifier": "(?P<tenant>[a-z0-9_-]+)\\.(?P<wd>wd\\d+)\\.myworkdayjobs\\.com/(?:[a-z]{2}-[A-Za-z]{2}/)?(?:wday/cxs/[^/]+/)?(?P<site>[A-Za-z0-9_-]+)",
   "connector": "WORKDAY_ATS",
   "config": "config/workday_sources.py",
   "strategy": "INTERNAL_JSON",
   "endpoint": "https://{tenant}.{wd}.myworkdayjobs.com/wday/cxs/{tenant}/{site}/jobs"
