   "connector": "PHENOM_ATS",
   "config": "config/phenom_sources.py",
   "strategy": "SITEMAP_JSONLD",
   "endpoint": "https://{identifiant}/sitemap.xml"
  },
  "TEAMTAILOR": {
   "url_patterns": [
    "teamtailor\\.com",
    "teamtailor-cdn\\.com",
